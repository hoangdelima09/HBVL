# ─── HBVL — environment template (placeholders only; NEVER commit real secrets) ───
# Copy to .env for local development:  cp .env.example .env  and run `pnpm setup:env` (generates .env directly)
# (scripts/setup-env.mjs fills the CHANGE_ME values with random secrets.)

NODE_ENV=development
APP_ENV=local                         # local | staging | production
TZ=UTC

# ── Public URLs ──
PUBLIC_ORIGIN=http://localhost:3100   # browser-facing origin (web). CSRF/Origin allowlist derives from this.
WEB_PORT=3100
API_PORT=3101
API_INTERNAL_URL=http://127.0.0.1:3101   # used by Next SSR and rewrites to reach the API
TRUST_PROXY=1                         # proxy hops between the Internet and the API (Next SSR and the reverse proxy each forward the client IP in X-Forwarded-For)

# ── PostgreSQL (app user has least privilege; migrator is a separate role) ──
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55432
POSTGRES_DB=hbvl
POSTGRES_ADMIN_PASSWORD=CHANGE_ME      # superuser used only by docker init + migrations in local
POSTGRES_APP_USER=hbvl_app
POSTGRES_APP_PASSWORD=CHANGE_ME
POSTGRES_MIGRATOR_USER=hbvl_migrator
POSTGRES_MIGRATOR_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql://hbvl_app:CHANGE_ME@127.0.0.1:55432/hbvl           # runtime (API/worker)
MIGRATION_DATABASE_URL=postgresql://hbvl_migrator:CHANGE_ME@127.0.0.1:55432/hbvl   # migrate deploy / seed
DB_POOL_MAX=10                         # per process; total = (api+worker replicas) × this ≤ server max_connections budget

# ── Redis ──
REDIS_HOST=127.0.0.1
REDIS_PORT=56379
REDIS_PASSWORD=CHANGE_ME
REDIS_URL=redis://:CHANGE_ME@127.0.0.1:56379

# ── Object storage (S3-compatible) ──
S3_ENDPOINT=http://127.0.0.1:58333
S3_REGION=us-east-1
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_FORCE_PATH_STYLE=true
S3_BUCKET_PRIVATE=hbvl-private         # originals + unpublished media (never public)

# ── Email (SMTP) ──
# Dev default = Mailpit (UI http://localhost:58025). For real mail (e.g. Gmail): SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=false,
# SMTP_USER=<gmail>, SMTP_PASSWORD=<16-char app password>, MAIL_FROM must use the same address. Tests always use Mailpit.
# MAILPIT_SMTP_PORT=51025   # host port of the Mailpit container (compose.yaml); independent of SMTP_PORT
SMTP_HOST=127.0.0.1
SMTP_PORT=51025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Học Bổng Vươn Lên <no-reply@hbvl.local>"
CONTACT_INBOX_EMAIL=quykhuyenhocdongdu@gmail.com     # from legacy theme; override per environment. Local: delivered to Mailpit only.

# ── Security secrets (≥ 32 random bytes each; generate with `openssl rand -base64 48`) ──
SESSION_COOKIE_NAME=hbvl_sid
CSRF_SECRET=CHANGE_ME
TOKEN_HASH_PEPPER=CHANGE_ME
MFA_ENCRYPTION_KEY=CHANGE_ME           # base64 32 bytes; encrypts TOTP secrets at rest
COOKIE_SECURE=false                    # true behind HTTPS

# ── Bootstrap admin (used ONLY by `pnpm bootstrap:admin`; password printed once if blank) ──
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_USERNAME=

# ── Legacy migration (paths OUTSIDE this repo; never committed) ──
LEGACY_SQL_DUMP=                       # e.g. /path/to/sampleweb_wp_export.sql
LEGACY_UPLOADS_DIR=                    # e.g. /path/to/wordpress/wp-content/uploads
LEGACY_THEME_DIR=                      # e.g. /path/to/wordpress/wp-content/themes/charity-hcm
LEGACY_MEMBERS_XLSX=                   # optional workbook
LEGACY_MYSQL_URL=mysql://root:CHANGE_ME@127.0.0.1:33061/sampleweb_wp   # temp restore DB, read-only account recommended

RATE_LIMIT_MULTIPLIER=1                # scales every endpoint limit (tests/load tests only; keep 1 in production)
EXTRA_ALLOWED_ORIGINS=                 # comma-separated extra browser origins allowed by the CSRF Origin check (normally empty)
EMAIL_ATTEMPTS=6                       # worker retries per e-mail before FAILED
EMAIL_BACKOFF_MS=30000                 # exponential backoff base
GLOBAL_RATE_LIMIT_PER_MIN=1200          # per client IP, all requests (safety net; endpoint-specific limits are much tighter)

# ── Observability ──
LOG_LEVEL=info

# ── AI site assistant (Gemini) — server-side only, never exposed to the browser ──
# Leave GEMINI_API_KEY empty to run the assistant in retrieval-only mode (it lists the relevant published articles instead of generating text).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite   # tried once when the primary is overloaded (503/429) or times out
# GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta
# CHAT_TIMEOUT_MS=20000
