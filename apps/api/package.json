{
  "name": "@hbvl/api",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS REST API + BullMQ worker entrypoint",
  "scripts": {
    "dev": "node dev.mjs dist/main.js",
    "dev:worker": "node dev.mjs dist/worker.js",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test:unit": "vitest run",
    "storage:init": "tsx src/cli/storage-init.ts",
    "bootstrap:admin": "tsx src/cli/bootstrap-admin.ts",
    "seed:dev": "tsx src/cli/seed-dev.ts",
    "import:members": "tsx src/cli/import-members.ts",
    "totp": "tsx src/cli/totp.ts",
    "migrate:legacy": "tsx src/cli/migrate-legacy.ts",
    "openapi:export": "node dist/cli/export-openapi.js",
    "ops": "tsx src/cli/ops.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1148.0",
    "@aws-sdk/s3-request-presigner": "3.1148.0",
    "@hbvl/contracts": "workspace:*",
    "@hbvl/database": "workspace:*",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@nestjs/swagger": "12.0.2",
    "@nestjs/throttler": "6.7.1",
    "argon2": "0.45.1",
    "bullmq": "6.3.12",
    "cookie-parser": "1.4.7",
    "dotenv": "18.0.7",
    "express": "5.3.0",
    "fast-xml-parser": "5.11.2",
    "fflate": "0.8.3",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "multer": "2.4.0",
    "mysql2": "3.24.5",
    "nodemailer": "10.0.16",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sanitize-html": "2.18.0",
    "sharp": "0.35.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@hbvl/config": "workspace:*",
    "@nestjs/testing": "12.1.2",
    "@swc/core": "1.16.13",
    "@types/cookie-parser": "1.4.9",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/sanitize-html": "2.16.2",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.3"
  }
}
