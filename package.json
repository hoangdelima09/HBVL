{
  "name": "hbvl",
  "version": "0.1.0",
  "private": true,
  "description": "Học Bổng Vươn Lên / Rise Up — Quỹ Khuyến Học Đông Du",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24.21.0 <25",
    "pnpm": ">=12.10.1"
  },
  "scripts": {
    "bootstrap:admin": "pnpm --filter @hbvl/api bootstrap:admin",
    "build": "pnpm -r build",
    "db:create": "pnpm --filter @hbvl/database exec node scripts/create-db.mjs",
    "db:generate": "pnpm --filter @hbvl/database generate",
    "db:migrate": "pnpm --filter @hbvl/database migrate:deploy",
    "db:migrate:dev": "pnpm --filter @hbvl/database migrate:dev",
    "db:seed": "pnpm --filter @hbvl/database seed",
    "db:studio": "pnpm --filter @hbvl/database studio",
    "dev": "pnpm -r --parallel --filter @hbvl/api --filter @hbvl/web dev",
    "docs:erd": "node scripts/docs/gen-erd.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:down": "docker compose down",
    "infra:up": "docker compose up -d --wait postgres redis storage mailpit",
    "lint": "pnpm -r lint",
    "migrate:legacy": "pnpm --filter @hbvl/api migrate:legacy",
    "openapi:export": "pnpm --filter @hbvl/api openapi:export",
    "ops": "pnpm --filter @hbvl/api ops",
    "seed:dev": "pnpm --filter @hbvl/api seed:dev",
    "import:members": "pnpm --filter @hbvl/api import:members",
    "reindex:search": "pnpm --filter @hbvl/api reindex:search",
    "setup:env": "node scripts/setup-env.mjs",
    "storage:init": "pnpm --filter @hbvl/api storage:init",
    "test:a11y": "pnpm --filter @hbvl/tests test:a11y",
    "test:e2e": "pnpm --filter @hbvl/tests test:e2e",
    "test:integration": "pnpm --filter @hbvl/tests test:integration",
    "test:load": "pnpm --filter @hbvl/tests test:load",
    "test:migration": "pnpm --filter @hbvl/tests test:migration",
    "test:smoke": "pnpm --filter @hbvl/tests test:smoke",
    "test:unit": "pnpm -r test:unit",
    "totp": "pnpm --filter @hbvl/api totp",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.4.0",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  }
}
